DATABASE_URL=
DATA_FILE=data/store.json
PORT=4000
# Comma-separated. In development, private LAN origins on 5173/4173 are also allowed for phone sign-in.
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
SESSION_TTL_HOURS=12
TRUST_PROXY=false

STORAGE_DRIVER=r2
STORAGE_DIR=storage
STORAGE_CLEANUP_GRACE_HOURS=48

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=creationsbysneha-assets
R2_PRIVATE_BUCKET_NAME=creationsbysneha-private
R2_PUBLIC_BASE_URL=https://assets.example.com
BUCKET_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Logging. Pretty color output in development, JSON in production.
# Defaults: debug in development, info in production. Query logs stay off unless enabled.
LOG_LEVEL=debug
LOG_HTTP_REQUESTS=true
LOG_DATABASE_QUERIES=false
LOG_R2_OPERATIONS=true
LOG_AUTH_EVENTS=true
